# KaushalSetu environment settings
#
# 1. Copy this file:   Copy-Item .env.example .env
# 2. Change POSTGRES_PASSWORD in .env to your own local password.
# .env is ignored by git. Never commit real passwords or API keys.

# ---------- PostgreSQL container (read by docker-compose.yml) ----------
POSTGRES_USER=kaushal
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=kaushalsetu
# Port on YOUR machine. We use 5433 (not the usual 5432) so KaushalSetu does not
# clash with any other PostgreSQL you may already run. Change it if 5433 is taken.
POSTGRES_HOST_PORT=5433

# ---------- Backend (read by FastAPI and Alembic) ----------
# The backend builds its database URL from the POSTGRES_* values above,
# connecting to 127.0.0.1:POSTGRES_HOST_PORT. Leave DATABASE_URL empty
# unless you need to point at a different database.
# (Use 127.0.0.1, not "localhost": on Windows "localhost" can stall on IPv6.)
DATABASE_URL=
APP_ENV=dev

# ---------- Login tokens (JWT) ----------
# REQUIRED. A long random secret used to sign login tokens. The API will not start without it.
# Generate one (backend venv active) and paste it here:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit it. Anyone who knows it can create valid logins.
JWT_SECRET=
# Optional (defaults shown in backend/app/core/settings.py):
# HS256 | HS384 | HS512
JWT_ALGORITHM=
# Token lifetime in minutes (5-1440).
JWT_EXPIRES_MINUTES=

# ---------- Account protection (optional; defaults in settings.py) ----------
# true | false. Public sign-up is only ever for the "candidate" role.
AUTH_PUBLIC_REGISTRATION=
AUTH_PASSWORD_MIN_LENGTH=
AUTH_LOGIN_MAX_FAILURES=
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=
AUTH_LOGIN_WINDOW_SECONDS=
AUTH_REGISTER_MAX_PER_IP_PER_HOUR=

# ---------- Optional overrides of config/*.yaml (leave empty to use the YAML values) ----------
# Business rules (weights, thresholds, sectors, districts) can only be changed in config/*.yaml.
# These switches exist because they differ per computer or deployment.
# (Keep comments on their own lines: "KEY=  # text" would make the text the value.)

# Other config folder (relative to the repository root, or absolute).
CONFIG_DIR=
# none | mock | ollama | openai | anthropic
LLM_PROVIDER=
# off | cache_only | live
LLM_MODE=
# Model name for the chosen provider.
LLM_MODEL=
LLM_MAX_CALLS_PER_JOB=
# Secret: only here, never in config/llm.yaml.
LLM_API_KEY=
# true | false
EMBEDDINGS_ENABLED=
# Folder with the downloaded embedding model.
EMBEDDING_MODEL_PATH=
# Seed for the synthetic data generator.
SYNTH_SEED=
